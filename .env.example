# Facultatif : docker compose up -d --build fonctionne sans ce fichier.
# Adresse locale : http://localhost:8765
REELS_PORT=8765

# Pour un autre port, modifier REELS_PORT ; l'adresse locale suit ce port.
# Pour un accès HTTPS distant facultatif, décommenter les deux lignes :
# REELS_DOMAIN=reels.exemple.fr
# REELS_PUBLIC_URL=https://reels.exemple.fr

# Les clés d'accès et cookies ne doivent pas être placés dans ce fichier.
